// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  avatar       String?
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  projects Project[]
  apiKeys  UserApiKey[]
  characterLibrary CharacterLibrary[]
  templates        Template[]
  templateFavorites TemplateFavorite[]

  @@map("users")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  style       String?
  aspectRatio String   @default("9:16") @map("aspect_ratio")
  status      String   @default("draft")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  characters Character[]
  episodes   Episode[]
  storyboard Storyboard[]
  shots      Shot[]
  tasks      GenerationTask[]
  preference ModelPreference?
  versions   ProjectVersion[]
  template   Template?  @relation(fields: [templateId], references: [id], onDelete: SetNull)

  templateId String? @map("template_id")

  @@map("projects")
}

model Episode {
  id          String   @id @default(uuid())
  number      Int
  title       String?
  description String?  @db.Text
  status      String   @default("draft")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  storyboard Storyboard[]

  @@unique([projectId, number])
  @@map("episodes")
}

model Character {
  id          String  @id @default(uuid())
  name        String
  gender      String?
  age         Int?
  role        String?
  personality String? @db.Text
  appearance  String? @db.Text
  outfit      String? @db.Text
  prompt      String? @db.Text
  mainImage   String? @map("main_image")
  images      Json?
  viewImages  Json?   @map("view_images")     // 四视图 {front, three_quarter, side, back}
  variants    Json?                           // 变体集合 [{type, imageUrl, description}]
  lockLevel   String? @map("lock_level")      // loose | medium | strict

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  libraryCharacterId String?            @map("library_character_id")
  libraryCharacter   CharacterLibrary?  @relation(fields: [libraryCharacterId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("characters")
}

model CharacterLibrary {
  id          String  @id @default(uuid())
  name        String
  gender      String?
  age         Int?
  role        String?
  personality String? @db.Text
  appearance  String? @db.Text
  outfit      String? @db.Text
  prompt      String? @db.Text
  mainImage   String? @map("main_image")
  images      Json?
  viewImages  Json?   @map("view_images")
  variants    Json?
  lockLevel   String? @map("lock_level")
  tags        Json?    // ["主角", "校园", "古风"] 用于搜索和分类

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  characters Character[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("character_library")
}

model Storyboard {
  id          String  @id @default(uuid())
  sequence    Int
  description String? @db.Text
  scene       String?
  emotion     String?
  duration    Int     @default(3000)
  characters  Json?

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  episodeId String?   @map("episode_id")
  episode   Episode?  @relation(fields: [episodeId], references: [id], onDelete: SetNull)

  shots Shot[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("storyboards")
}

model Shot {
  id          String  @id @default(uuid())
  sequence    Int
  prompt      String? @db.Text
  negativePrompt String? @map("negative_prompt") @db.Text
  params      Json?
  status      String  @default("pending")
  resultUrl   String? @map("result_url") @db.Text
  firstFrameUrl  String? @map("first_frame_url") @db.Text   // 首帧
  lastFrameUrl   String? @map("last_frame_url") @db.Text    // 尾帧
  duration    Int     @default(3000)

  storyboardId String      @map("storyboard_id")
  storyboard   Storyboard  @relation(fields: [storyboardId], references: [id], onDelete: Cascade)
  projectId    String      @map("project_id")
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks GenerationTask[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("shots")
}

model UserApiKey {
  id            String   @id @default(uuid())
  alias         String
  keyEncrypted  String   @map("key_encrypted") @db.Text
  keyMask       String   @map("key_mask")
  status        String   @default("unverified")
  isDefault     Boolean  @default(false) @map("is_default")
  lastVerifiedAt DateTime? @map("last_verified_at")
  totalCalls    Int      @default(0) @map("total_calls")
  estimatedCost Float    @default(0) @map("estimated_cost")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  modelId String  @map("model_id")
  model   AIModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_api_keys")
}

model ModelPreference {
  id       String @id @default(uuid())
  defaults Json

  projectId String  @unique @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("model_preferences")
}

model AIModel {
  id          String  @id
  name        String
  provider    String
  capability  String
  icon        String?
  description String? @db.Text
  docUrl      String? @map("doc_url")
  pricingUrl  String? @map("pricing_url")
  apiBaseUrl  String? @map("api_base_url")
  parameters  Json?
  supports    Json?
  status      String  @default("active")
  billingUnit String? @map("billing_unit")
  billingRule Json?   @map("billing_rule")

  apiKeys UserApiKey[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_models")
}

model GenerationTask {
  id         String  @id @default(uuid())
  capability String
  modelId    String  @map("model_id")
  apiKeyId   String  @map("api_key_id")
  parameters Json?
  input      Json?
  status     String  @default("pending")
  progress   Int     @default(0)
  result     Json?
  error      Json?
  retryCount Int     @default(0) @map("retry_count")
  startedAt  DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shotId    String? @map("shot_id")
  shot      Shot?   @relation(fields: [shotId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("generation_tasks")
}

model ProjectVersion {
  id          String   @id @default(uuid())
  version     Int
  label       String?
  snapshot    Json     // 完整项目快照（characters + storyboard + shots）
  createdAt   DateTime @default(now()) @map("created_at")

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@map("project_versions")
}

model Template {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  category    String   @default("general")
  tags        Json?
  coverUrl    String?  @map("cover_url")
  isPublic    Boolean  @default(true) @map("is_public")
  snapshot    Json     // 完整项目快照
  usageCount  Int      @default(0) @map("usage_count")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  favorites TemplateFavorite[]
  projects  Project[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("templates")
}

model TemplateFavorite {
  id     String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  templateId String   @map("template_id")
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, templateId])
  @@map("template_favorites")
}
