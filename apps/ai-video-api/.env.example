# Database
DATABASE_URL="mysql://user:password@localhost:3306/ai_video"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT (必须配置，不能留默认值)
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# API Key 加密（强烈建议单独配置，不配置则回退使用 JWT_SECRET）
# 注意：如果修改此值，需要重新加密数据库中已有的 API Key
AES_KEY=""

# Frontend
FRONTEND_URL="http://localhost:3000"

# Storage (MinIO / S3)
STORAGE_ENDPOINT="localhost"
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET="ai-video"
